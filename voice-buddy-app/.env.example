# Server-side secrets for Vercel serverless functions (api/*).
# Set these in the Vercel project's Environment Variables — never commit real values.

# Groq chat completions (api/chat.js, api/ping.js)
GROQ_API_KEY=

# Google Cloud Text-to-Speech (api/tts.js)
GOOGLE_TTS_KEY=

# Supabase service role — used server-side to check entitlements and write
# subscription/payment state. Falls back to the public project URL if unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# PayFast subscription billing (api/payfast-create.js, api/payfast-webhook.js)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
APP_URL=https://voice-buddy.vercel.app
