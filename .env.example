# Server-side secrets for Vercel serverless functions (api/*).
# Set these in the Vercel project's Environment Variables — never commit real values.

# Groq chat completions (api/chat.js, api/ping.js) and Groq TTS — the
# primary voice for the sunny/buddy/captain personas (api/tts.js)
GROQ_API_KEY=

# Google Cloud Text-to-Speech (api/tts.js) — covers every persona Groq
# doesn't have a voice for yet, and is the fallback if a Groq call fails
GOOGLE_TTS_KEY=

# Supabase service role — used server-side to check entitlements and write
# subscription/payment state. Falls back to the public project URL if unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LiveKit realtime voice agent (api/livekit-agent.js)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Client-side build-time flag (src/services/livekitAgentService.js) — set to
# "true" to route ChildPage voice replies through the LiveKit avatar agent
# instead of the default chat/TTS flow. Requires the LIVEKIT_* vars above.
VITE_USE_LIVEKIT_AVATAR_VOICE=

# PayFast subscription billing (api/payfast-create.js, api/payfast-webhook.js)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
APP_URL=https://voice-buddy.vercel.app
