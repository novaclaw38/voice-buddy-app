# This repo root is the home directory — whitelist only the app so nothing
# else (.ssh, .claude.json, shell history, other projects) can ever be added.
/*
!/.gitignore
!/voice-buddy-app

# Ignored everywhere, including inside voice-buddy-app/
node_modules/
dist/
.env
.env.local
.DS_Store
*.log
.vercel
.superpowers/
